{
  "name": "@pinop/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run && pnpm run test:public",
    "test:public": "pnpm run build && pnpm run test:public-types:check && node test/public-export.mjs",
    "test:public-types": "pnpm run build && pnpm run test:public-types:check",
    "test:public-types:check": "tsc --noEmit -p test/public-types.tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
