{
  "name": "pin-op",
  "publisher": "conus-vision",
  "displayName": "PinOp",
  "description": "Connect browser DevTools to your source code.",
  "version": "0.3.0",
  "license": "MIT",
  "repository": "https://github.com/conus-vision/pin-op.git",
  "homepage": "https://pin-op.conus.vision",
  "bugs": "https://github.com/conus-vision/pin-op/issues",
  "icon": "resources/pinop.png",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "browser",
    "devtools",
    "css",
    "scss",
    "source maps",
    "websocket"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pin-op.start",
        "title": "PinOp: Start"
      },
      {
        "command": "pin-op.stop",
        "title": "PinOp: Stop"
      },
      {
        "command": "pin-op.copyLinkCode",
        "title": "PinOp: Copy Link Code"
      },
      {
        "command": "pin-op.openDiagnostics",
        "title": "PinOp: Open Diagnostics"
      },
      {
        "command": "pin-op.revealSourceMatch",
        "title": "PinOp: Reveal Source Match"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pin-op",
          "title": "PinOp",
          "icon": "resources/pinop.svg"
        }
      ]
    },
    "views": {
      "pin-op": [
        {
          "id": "pin-op.applicableRules",
          "name": "Applicable Sources"
        }
      ]
    },
    "colors": [
      {
        "id": "pin-op.selectedRuleBackground",
        "description": "Background for rules matching the selected DOM element.",
        "defaults": {
          "dark": "#2EA04322",
          "light": "#1A7F3720",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "pin-op.selectedRuleBorder",
        "description": "Border for rules matching the selected DOM element.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#FFFFFF"
        }
      },
      {
        "id": "pin-op.parentRuleBackground",
        "description": "Background for rules matching the immediate DOM parent.",
        "defaults": {
          "dark": "#2F81F722",
          "light": "#0969DA1F",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "pin-op.parentRuleBorder",
        "description": "Border for rules matching the immediate DOM parent.",
        "defaults": {
          "dark": "#58A6FF",
          "light": "#0969DA",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "configuration": {
      "title": "PinOp",
      "properties": {
        "pin-op.sessionId": {
          "type": "string",
          "default": "default"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "package": "node ./package-vsix.mjs",
    "smoke:vsix": "node ./smoke-installed-vsix.mjs ../../artifacts/pinop-vscode-0.3.0.vsix",
    "build": "pnpm run typecheck && node ./esbuild.mjs",
    "test": "pnpm --filter @pin-op/protocol build && pnpm --filter @pin-op/bridge build && vitest run --exclude \"test/integration/**\"",
    "test:integration": "pnpm run build && pnpm --filter pin-op-source-plugin-fixture build && vscode-test --label sourcePluginApi",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pin-op/bridge": "workspace:*",
    "@pin-op/plugin-api": "workspace:*",
    "@pin-op/protocol": "workspace:*",
    "postcss": "8.5.16",
    "postcss-selector-parser": "7.1.0",
    "postcss-scss": "4.0.9",
    "source-map": "^0.7.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.21.5",
    "mocha": "^11.7.6",
    "vitest": "^2.1.0"
  }
}
