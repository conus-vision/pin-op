{
  "name": "browser2ide-vscode",
  "publisher": "browser2ide",
  "displayName": "Browser2IDE",
  "version": "0.3.0",
  "license": "MIT",
  "repository": "https://github.com/conus-vision/Browser2IDE.git",
  "homepage": "https://github.com/conus-vision/Browser2IDE#readme",
  "bugs": "https://github.com/conus-vision/Browser2IDE/issues",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "browser",
    "devtools",
    "css",
    "scss",
    "source maps",
    "websocket"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "browser2ide.start",
        "title": "Browser2IDE: Start"
      },
      {
        "command": "browser2ide.stop",
        "title": "Browser2IDE: Stop"
      },
      {
        "command": "browser2ide.copyLinkCode",
        "title": "Browser2IDE: Copy Link Code"
      },
      {
        "command": "browser2ide.openDiagnostics",
        "title": "Browser2IDE: Open Diagnostics"
      },
      {
        "command": "browser2ide.revealSourceMatch",
        "title": "Browser2IDE: Reveal Source Match"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "browser2ide",
          "title": "Browser2IDE",
          "icon": "resources/browser2ide.svg"
        }
      ]
    },
    "views": {
      "browser2ide": [
        {
          "id": "browser2ide.applicableRules",
          "name": "Applicable Sources"
        }
      ]
    },
    "colors": [
      {
        "id": "browser2ide.selectedRuleBackground",
        "description": "Background for rules matching the selected DOM element.",
        "defaults": {
          "dark": "#2EA04322",
          "light": "#1A7F3720",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "browser2ide.selectedRuleBorder",
        "description": "Border for rules matching the selected DOM element.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#FFFFFF"
        }
      },
      {
        "id": "browser2ide.parentRuleBackground",
        "description": "Background for rules matching the immediate DOM parent.",
        "defaults": {
          "dark": "#2F81F722",
          "light": "#0969DA1F",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "browser2ide.parentRuleBorder",
        "description": "Border for rules matching the immediate DOM parent.",
        "defaults": {
          "dark": "#58A6FF",
          "light": "#0969DA",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "configuration": {
      "title": "Browser2IDE",
      "properties": {
        "browser2ide.sessionId": {
          "type": "string",
          "default": "default"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "package": "node ./package-vsix.mjs",
    "smoke:vsix": "node ./smoke-installed-vsix.mjs ../../artifacts/browser2ide-vscode-0.3.0.vsix",
    "build": "pnpm run typecheck && node ./esbuild.mjs",
    "test": "pnpm --filter @browser2ide/protocol build && pnpm --filter @browser2ide/bridge build && vitest run --exclude \"test/integration/**\"",
    "test:integration": "pnpm run build && pnpm --filter source-plugin-fixture build && vscode-test --label sourcePluginApi",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@browser2ide/bridge": "workspace:*",
    "@browser2ide/plugin-api": "workspace:*",
    "@browser2ide/protocol": "workspace:*",
    "postcss": "8.5.16",
    "postcss-selector-parser": "7.1.0",
    "postcss-scss": "4.0.9",
    "source-map": "^0.7.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.21.5",
    "mocha": "^11.7.6",
    "vitest": "^2.1.0"
  }
}
