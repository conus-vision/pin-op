{
  "name": "pin-op-source-plugin-fixture",
  "displayName": "PinOp Source Plugin Fixture",
  "publisher": "conus-vision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.cjs",
  "extensionDependencies": [
    "conus-vision.pin-op"
  ],
  "activationEvents": [
    "onLanguage:pinop-fixture"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pinop-fixture",
        "extensions": [".pinop-fixture"]
      }
    ]
  },
  "scripts": {
    "build": "pnpm run typecheck && node ./esbuild.mjs",
    "test": "pnpm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pin-op/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0"
  }
}
