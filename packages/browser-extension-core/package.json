{
  "name": "@browser2ide/browser-extension-core",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @browser2ide/protocol build && vitest run && pnpm run build && node test/public-export.mjs",
    "test:public": "pnpm --filter @browser2ide/protocol build && pnpm run build && node test/public-export.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@browser2ide/protocol": "workspace:*",
    "lucide": "0.468.0",
    "zod": "^3.25.76"
  }
}
